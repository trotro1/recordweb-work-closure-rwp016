    "closedBy": {"@id": "wce:closedBy", "@type": "@id"},
    "closedAt": {"@id": "wce:closedAt", "@type": "xsd:dateTime"},
    "owner": {"@id": "wce:owner", "@type": "@id"},
    "successorWork": {"@id": "wce:successorWork", "@type": "@id"},
    "acknowledgedBy": {"@id": "wce:acknowledgedBy", "@type": "@id"},
